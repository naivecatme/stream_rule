DOMAIN-SUFFIX,vine.co

# Specific CDN name, not the shared fastly.net domain or Fastly ASN
DOMAIN-SUFFIX,twitter.map.fastly.net

# Preserves original keyword coverage; may also route unrelated names containing twitter
DOMAIN-KEYWORD,twitter

